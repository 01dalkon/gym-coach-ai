# API key gratuita: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxx

# Modelo (cámbialo si se agota el rate limit)
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it

# URL pública de la app
APP_URL=http://localhost:8000

# Orígenes permitidos para embeber el widget ("*" en desarrollo)
CORS_ORIGINS=*

PORT=

# Cache de respuestas LLM (reduce latencia en preguntas repetidas)
# "memory" = en proceso, sin deps extras (default para desarrollo local)
# "redis"  = Redis externo, recomendado en Docker
CACHE_BACKEND=redis
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
